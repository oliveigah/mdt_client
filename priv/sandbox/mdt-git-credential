#!/bin/sh
# Git credential helper installed by MDT. For hosts MDT holds a grant for, it
# answers with that grant's placeholder; MDT swaps it for the real token on
# the way out, after your rules (and approval) allow it. The placeholder is
# worthless anywhere else.
[ "$1" = get ] || exit 0
host=""
while IFS= read -r line; do
  case "$line" in
    host=*) host="${line#host=}" ;;
    "") break ;;
  esac
done
[ -n "$host" ] && [ -r "/mnt/mdt/git/$host" ] && cat "/mnt/mdt/git/$host"
exit 0
