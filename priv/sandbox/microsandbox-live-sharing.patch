+//! Host mutations bypass FUSE: cached identities must be revalidated, while
+//! existing open handles continue to refer to the original object.
+
+use super::*;
+
+#[test]
+fn test_normal_metadata_cache_and_buffered_io_are_preserved() {
+    let sb = TestSandbox::new();
+    sb.host_create_file("file", b"original");
+    let entry = sb.lookup_root("file").unwrap();
+    assert_eq!(entry.entry_timeout, std::time::Duration::from_secs(5));
+    assert_eq!(entry.attr_timeout, std::time::Duration::from_secs(5));
+
+    sb.host_create_file("file", b"changed and longer");
+    let (metadata, timeout) = sb.fs.getattr(sb.ctx(), entry.inode, None).unwrap();
+    assert_eq!(metadata.st_size, 18);
+    assert_eq!(timeout, std::time::Duration::from_secs(5));
+    let (_, options) = sb.fs.open(sb.ctx(), entry.inode, false, 0).unwrap();
+    assert!(!options.contains(OpenOptions::KEEP_CACHE));
+    assert!(!options.contains(OpenOptions::DIRECT_IO));
+}
+
+#[cfg(target_os = "linux")]
+#[test]
+fn test_host_replacement_keeps_valid_hard_link_aliases() {
+    let sb = TestSandbox::new();
+    sb.host_create_file("original", b"original");
+    let original = sb.lookup_root("original").unwrap();
+    sb.fs
+        .link(sb.ctx(), original.inode, ROOT_INODE, c"alias")
+        .unwrap();
+
+    sb.host_create_file("replacement", b"new bytes");
+    std::fs::rename(sb.root.join("replacement"), sb.root.join("original")).unwrap();
+
+    let handle = sb.fuse_open(original.inode, 0).unwrap();
+    assert_eq!(
+        sb.fuse_read(original.inode, handle, 32, 0).unwrap(),
+        b"original"
+    );
+    assert_eq!(
+        std::fs::read(sb.root.join("original")).unwrap(),
+        b"new bytes"
+    );
+}
+
+#[cfg(target_os = "linux")]
+#[test]
+fn test_host_replacement_returns_estale_instead_of_missing_file() {
+    let sb = TestSandbox::new();
+    sb.host_create_file("index", b"original");
+    let original = sb.lookup_root("index").unwrap();
+
+    sb.host_create_file("index.lock", b"replacement");
+    std::fs::rename(sb.root.join("index.lock"), sb.root.join("index")).unwrap();
+
+    // A cached FUSE node no longer identifies the object at this path. ESTALE
+    // lets the VFS retry the path lookup; ENOENT makes Git treat its index as empty.
+    let result = sb.fuse_open(original.inode, 0);
+    TestSandbox::assert_errno(result, 116);
+
+    let replacement = sb.lookup_root("index").unwrap();
+    assert_ne!(replacement.inode, original.inode);
+    let handle = sb.fuse_open(replacement.inode, 0).unwrap();
+    assert_eq!(
+        sb.fuse_read(replacement.inode, handle, 32, 0).unwrap(),
+        b"replacement"
+    );
+}
+
+#[cfg(target_os = "linux")]
+#[test]
+fn test_host_directory_replacement_revalidates_the_cached_parent() {
+    let sb = TestSandbox::new();
+    sb.host_create_file("directory/file", b"original");
+    let original = sb.lookup_root("directory").unwrap();
+
+    std::fs::rename(sb.root.join("directory"), sb.root.join("old-directory")).unwrap();
+    sb.host_create_file("directory/file", b"replacement");
+
+    TestSandbox::assert_errno(sb.lookup(original.inode, "file"), 116);
+    let replacement = sb.lookup_root("directory").unwrap();
+    let file = sb.lookup(replacement.inode, "file").unwrap();
+    let handle = sb.fuse_open(file.inode, 0).unwrap();
+    assert_eq!(
+        sb.fuse_read(file.inode, handle, 32, 0).unwrap(),
+        b"replacement"
+    );
+}
+
+#[cfg(target_os = "linux")]
+#[test]
+fn test_open_handle_survives_host_replacement() {
+    let sb = TestSandbox::new();
+    sb.host_create_file("file", b"original");
+    let original = sb.lookup_root("file").unwrap();
+    let handle = sb.fuse_open(original.inode, 0).unwrap();
+
+    sb.host_create_file("replacement", b"new bytes");
+    std::fs::rename(sb.root.join("replacement"), sb.root.join("file")).unwrap();
+
+    assert_eq!(
+        sb.fuse_read(original.inode, handle, 32, 0).unwrap(),
+        b"original"
+    );
+    let replacement = sb.lookup_root("file").unwrap();
+    let handle = sb.fuse_open(replacement.inode, 0).unwrap();
+    assert_eq!(
+        sb.fuse_read(replacement.inode, handle, 32, 0).unwrap(),
+        b"new bytes"
+    );
+}
