#!/bin/sh
# Run by MDT inside the VM after every boot, as root, from /mnt/mdt/bin. POSIX
# sh, so it runs in an image without bash.
#
# MDT never writes into anything the VM can write: what it has for the VM is
# in /mnt/mdt, read-only, and this script, running in the VM, copies the
# parts that tools expect elsewhere:
#
#   - MDT's instructions for agents, as a block between two markers at the
#     top of ~/.claude/CLAUDE.md and ~/.codex/AGENTS.md. The rest of each
#     file is left alone;
#   - the memo tool, into the VM's own memory folder, with an empty memory
#     when there is none;
#   - which VM this is, when MDT names it: `mdt-boot ID CREATED IMAGE NAME`
#     writes /etc/mdt-vm, which `mdt vm` sends MDT to compare with the VM it
#     runs, and a line every interactive login shell prints with the answer.
#
# MDT_INBOX, HOME and MDT_ETC (for /etc) can be set to try it outside a VM.
set -u
inbox=${MDT_INBOX:-/mnt/mdt}
block=$inbox/agents-block.md
begin='<!-- mdt:begin'
finish='<!-- mdt:end -->'

put_block() {
  local file=$1 partial
  mkdir -p "$(dirname "$file")" || return 1
  [ -e "$file" ] || : > "$file"
  partial=$(mktemp "$file.XXXXXX") || return 1

  if grep -qF -- "$begin" "$file"; then
    # Replaced where it was. A block that was never closed runs to the end.
    awk -v block="$block" -v begin="$begin" -v finish="$finish" '
      !inside && index($0, begin) == 1 {
        while ((getline line < block) > 0) print line
        inside = 1
        next
      }
      inside && index($0, finish) == 1 { inside = 0; next }
      !inside { print }
    ' "$file" > "$partial"
  else
    {
      cat "$block"
      [ -s "$file" ] && echo
      cat "$file"
    } > "$partial"
  fi

  mv "$partial" "$file"
}

status=0
etc=${MDT_ETC:-/etc}

if [ -n "${1:-}" ]; then
  {
    printf 'id=%s\n' "$1"
    printf 'created=%s\n' "${2:-}"
    printf 'image=%s\n' "${3:-}"
    printf 'name=%s\n' "${4:-}"
  } > "$etc/mdt-vm.new" && mv "$etc/mdt-vm.new" "$etc/mdt-vm" ||
    { echo "mdt-boot: could not write $etc/mdt-vm" >&2; status=1; }

  mkdir -p "$etc/profile.d" && {
    echo "# Written by MDT's boot script: which VM this is, in every interactive"
    echo "# login shell (Zed's terminals). \`mdt vm\` says it again."
    printf "mdt_vm_cli='%s'\n" "$inbox/bin/mdt"
    cat <<'PROFILE'
case $- in
  *i*)
    if [ -x "$mdt_vm_cli" ]; then
      mdt_vm_said=$(timeout 3 "$mdt_vm_cli" vm 2>&1)
      if [ $? -eq 0 ]; then
        printf '\033[2m%s\033[0m\n' "$mdt_vm_said"
      else
        printf '\033[1;31m%s\033[0m\n' "$mdt_vm_said"
      fi
      unset mdt_vm_said
    fi
    ;;
esac
unset mdt_vm_cli
PROFILE
  } > "$etc/profile.d/mdt-vm.sh" ||
    { echo "mdt-boot: could not write $etc/profile.d/mdt-vm.sh" >&2; status=1; }
fi

if [ -r "$block" ]; then
  for file in "$HOME/.claude/CLAUDE.md" "$HOME/.codex/AGENTS.md"; do
    put_block "$file" || { echo "mdt-boot: could not write $file" >&2; status=1; }
  done
fi

if [ -x "$inbox/bin/memo" ]; then
  optmem=$HOME/.optmem
  mkdir -p "$optmem" &&
    cp "$inbox/bin/memo" "$optmem/memo.new" &&
    chmod 0755 "$optmem/memo.new" &&
    mv "$optmem/memo.new" "$optmem/memo" || { echo "mdt-boot: could not copy memo" >&2; status=1; }

  if [ ! -f "$optmem/memory/LOG.txt" ]; then
    MEMORY_DIR=$optmem/memory "$optmem/memo" init >/dev/null 2>&1 ||
      { echo "mdt-boot: memo init failed" >&2; status=1; }
  fi
fi

exit $status
